#a
ages <- c(20,20,20,20,20,20,
          21,21,21,21,
          22,22,22,
          23,23,23,23,
          24,24,
          65)
mean_age <- mean(ages)
median_age <- median(ages)
# Mode function (simple beginner-friendly)
get_mode <- function(v){
  uniq <- unique(v)
  uniq[which.max(tabulate(match(v, uniq)))]
}
mode_age <- get_mode(ages)
mean_age
median_age
mode_age
outlier_values <- boxplot(ages)$out
outlier_values
hist(ages,
     col = "lightblue",
     main = "Age Distribution with Mean/Median/Mode",
     xlab = "Ages")
abline(v = mean_age, col = "red", lwd = 2)
abline(v = median_age, col = "blue", lwd = 2)
abline(v = mode_age, col = "green", lwd = 2)
ages2 <- ages[ages != 65]
mean_age2 <- mean(ages2)
median_age2 <- median(ages2)
mode_age2 <- get_mode(ages2)
mean_age2
median_age2
mode_age2

