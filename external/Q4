# Sample dataframe
df <- data.frame(
  id = 1:6,
  age = c(21, 23, 19, 25, 20, 22),
  marks = c(80, 75, 90, 85, 70, 95),
  gender = c("M","F","F","M","F","M")
)
# Subsetting
subset(df, age > 21)
subset(df, gender == "F")
subset(df, marks >= 80 & gender == "M")
# Aggregation (same style as summary, mean, etc. from your programs)
mean(df$marks)
sum(df$marks)
min(df$marks)
max(df$marks)
# Aggregate by gender
aggregate(marks ~ gender, data = df, FUN = mean)
aggregate(age ~ gender, data = df, FUN = max)

