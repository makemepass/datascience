# Function to print Fibonacci series
fib <- function(n) {
  a <- 0
  b <- 1
  print(a)
  print(b)
  for(i in 3:n){
    c <- a + b
    print(c)
    a <- b
    b <- c
  }
}
# Call the function
fib(10)    # prints first 10 Fibonacci numbers

