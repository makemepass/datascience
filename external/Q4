internal <- c(15,23,18,23,24,22,22,19,19,16,24,11,24,16,23)
external <- c(49,63,58,60,58,61,60,63,60,52,62,30,59,49,68)
df <- data.frame(internal, external)
df
model <- lm(external ~ internal, data = df)
summary(model)
model$coefficients      # slope and intercept
model$residuals         # residual values
plot(df$internal, df$external,
     col = "blue", pch = 16,
     xlab = "Internal Marks",
     ylab = "External Marks",
     main = "Linear Regression Plot")

abline(model, col = "red", lwd = 2)
