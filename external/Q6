#a
# Create dataset
df <- data.frame(
  millage = c(18,25,50,68,75,65),
  age = c(1,2,2,3,4,5),
  price = c(29,25,21,18,15,15)
)
df
# Build Multiple Linear Regression Model
model <- lm(price ~ millage + age, data = df)
# Model Summary (Regression coefficients)
summary(model)
# Predict price for a new car
test_car <- data.frame(millage = 40, age = 3)
predicted_price <- predict(model, test_car)
predicted_price

