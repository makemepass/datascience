#c
# Basic string
s <- "Data Science Lab"
# nchar() - number of characters
nchar(s)
# substr() - extract part of string
substr(s, 1, 4)
# paste() - combining strings
paste("Hello", "World")
# toupper() and tolower()
toupper(s)
tolower(s)
# strsplit() - split a string
strsplit(s, " ")
# grep() - find matching pattern
grep("Science", s)
# sub() and gsub() - replace text
sub("Science", "Analytics", s)
gsub("a", "A", s)
