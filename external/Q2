# Create a matrix (same style as Program 1)
mat <- matrix(c(1, 2, 3, 4, 5, 6), nrow = 3, ncol = 2)
print(mat)
# Matrix subsetting (same as Program 1)
mat[1, 2]        # element in row 1 column 2
mat[2, ]         # entire row 2
mat[, 1]         # entire column 1
mat[c(1,3), ]    # rows 1 and 3
mat[, c(1,2)]    # columns 1 and 2

#b
# Two matrices for operations
m1 <- matrix(c(1, 2, 3, 4), nrow = 2)
m2 <- matrix(c(5, 6, 7, 8), nrow = 2)
# Addition
m_add <- m1 + m2
print(m_add)
# Subtraction
m_sub <- m1 - m2
print(m_sub)
# Adding rows (rbind)
m_row_added <- rbind(m1, c(10, 20))
print(m_row_added)
# Adding columns (cbind)
m_col_added <- cbind(m1, c(100, 200))
print(m_col_added)

#c
# Given data
x <- c(2, 4, 5, 6, 8)
y <- c(60, 75, 80, 85, 95)
# Step 1: Means
mean_x <- mean(x)
mean_y <- mean(y)
# Step 2: Deviations
dx <- x - mean_x
dy <- y - mean_y
# Step 3: Numerator (sum of product of deviations)
num <- sum(dx * dy)
# Step 4: Denominator
den <- sqrt(sum(dx^2) * sum(dy^2))
# Step 5: Correlation
cor_xy <- num / den
cor_xy
