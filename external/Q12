#a
# Load cars dataset
data(cars)
cars
# Boxplot of speed
boxplot(cars$speed,
        col = "orange",
        main = "Boxplot of Speed",
        ylab = "Speed")
# Scatter plot (speed vs distance)
plot(cars$speed, cars$dist,
     col = "blue", pch = 16,
     main = "Scatter Plot: Speed vs Distance",
     xlab = "Speed",
     ylab = "Distance")
# Histogram of distance
hist(cars$dist,
     col = "green",
     main = "Histogram of Distance",
     xlab = "Distance",
     border = "red")

