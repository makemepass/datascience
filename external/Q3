df3

#c
data(iris)
# Use only numeric columns for K-means
iris_data <- iris[, 1:4]
# Build k-means model with 3 clusters
set.seed(101)
km <- kmeans(iris_data, centers = 3)
# Print cluster centers
km$centers
# Optional: check how clusters match species
table(km$cluster, iris$Species)
