#a
A <- c(200, 220, 250)
B <- c(180, 190, 185)
C <- c(240, 230, 260)
all_values <- c(A, B, C)
group <- c(rep("A",3), rep("B",3), rep("C",3))
overall_mean <- mean(all_values)
overall_mean
mean_A <- mean(A)
mean_B <- mean(B)
mean_C <- mean(C)
mean_A; mean_B; mean_C
SSB <- 3*(mean_A - overall_mean)^2 +
  3*(mean_B - overall_mean)^2 +
  3*(mean_C - overall_mean)^2
SSB
SSW <- sum((A - mean_A)^2) +
  sum((B - mean_B)^2) +
  sum((C - mean_C)^2)
SSW
df_between <- 3 - 1
df_within  <- 9 - 3
MSB <- SSB / df_between
MSW <- SSW / df_within
F_value <- MSB / MSW
F_value

